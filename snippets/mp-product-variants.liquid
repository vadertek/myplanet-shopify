<input
  id="mp-product-variant-id-{{ product.id }}"
  type="hidden"
  name="id"
  value="{{ product.selected_or_first_available_variant.id }}"
>

{%- unless product.has_only_default_variant or product.variants.size == 0 -%}
  <div class="mt-8 flex flex-wrap items-center gap-6 font-nunito">
    <p class="text-base leading-none font-normal text-(--pdp-accent)">{{ 'general.custom.volume' | t }}</p>
    <div id="mp-product-variants-{{ product.id }}" class="flex flex-wrap gap-2">
      {%- for variant in product.variants -%}
        <button
          class="h-9 cursor-pointer rounded-2xl border px-4 text-base leading-none font-normal transition{% if variant.id == product.selected_or_first_available_variant.id %} border-(--pdp-accent) text-(--pdp-accent){% else %} border-(--pdp-muted) text-(--pdp-muted){% endif %}"
          type="button"
          value="{{ variant.id }}"
        >
          {{ variant.title | escape }}
        </button>
      {%- endfor -%}
    </div>
  </div>
{%- endunless -%}
