{%- comment -%}
  "Join the list" popup ("Дізнавайтеся першими") with a newsletter sign-up form.
  Not connected anywhere yet.

  Usage:
    {% render 'mp-join-popup' %}                → rendered hidden
    {% render 'mp-join-popup', open: true %}    → rendered open

  Texts: Theme settings → MP Popups → Join the list popup.
  Optional params (override theme settings): title, text, button_text, decline_text, disclaimer, success_text, tags.

  The form is a Shopify newsletter form: the email is saved as a customer
  with the "newsletter" tag (+ `tags`). After submit the page reloads and the popup
  opens by itself with the success / error message.
  "Ні, дякую" just closes the popup.

  JS:
    window.mpJoinPopup.open();
    window.mpJoinPopup.close();

  Desktop: 720×400 — image left (336×400), content right.
  Mobile: image on top, content below.
{%- endcomment -%}

{%- liquid
  assign popup_title = title | default: settings.mp_popup_join_title
  assign popup_text = text | default: settings.mp_popup_join_text
  assign popup_button_text = button_text | default: settings.mp_popup_join_button
  assign popup_decline_text = decline_text | default: settings.mp_popup_join_decline
  assign popup_disclaimer = disclaimer | default: settings.mp_popup_join_disclaimer
  assign popup_success_text = success_text | default: settings.mp_popup_join_success
  assign popup_tags = 'newsletter,popup-join'
  if tags != blank
    assign popup_tags = popup_tags | append: ',' | append: tags
  endif
-%}

{%- capture popup_form -%}
  {%- form 'customer', id: 'mp-join-popup-form', class: 'mt-8 flex w-full flex-col' -%}
    {%- if form.posted_successfully? -%}
      <p class="rounded-2xl border border-[#1EBECA] bg-white px-4 py-3 text-[14px] leading-[1.3] font-medium text-[#325037]" role="status">
        {{ popup_success_text | escape }}
      </p>
    {%- else -%}
      <input type="hidden" name="contact[tags]" value="{{ popup_tags | escape }}">

      {%- if form.errors -%}
        <p class="mb-2 text-[12px] leading-[1.3] font-medium text-[#D71920]" role="alert">
          {%- if form.errors contains 'email' -%}
            {{ 'general.custom.email-error' | t }}
          {%- else -%}
            {{ form.errors | default_errors }}
          {%- endif -%}
        </p>
      {%- endif -%}

      <label class="sr-only" for="mp-join-popup-email">{{ 'general.custom.email' | t }}</label>
      <input
        id="mp-join-popup-email"
        class="h-12 w-full rounded-2xl border border-[#1EBECA] bg-white px-4 py-2 text-[16px] leading-[1.3] font-medium text-[#325037] outline-none placeholder:text-[#1EBECA] focus-visible:ring-2 focus-visible:ring-[#1EBECA]/40"
        type="email"
        name="contact[email]"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        placeholder="{{ 'general.custom.email' | t | escape }}"
        required
        value="{{ form.email }}"
        {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
      >

      <div class="mt-2 grid grid-cols-2 gap-2.5">
        <button
          type="submit"
          class="flex h-12 cursor-pointer items-center justify-center rounded-2xl border border-[#1EBECA] bg-[#1EBECA] px-4 text-[16px] leading-none font-bold text-white transition hover:opacity-85 focus-visible:opacity-85"
        >
          {{ popup_button_text | escape }}
        </button>

        <button
          type="button"
          class="flex h-12 cursor-pointer items-center justify-center rounded-2xl border border-[#1EBECA] bg-white px-4 text-[16px] leading-none font-bold text-[#1EBECA] transition hover:bg-[#1EBECA] hover:text-white focus-visible:bg-[#1EBECA] focus-visible:text-white"
          data-mp-join-popup-close
        >
          {{ popup_decline_text | escape }}
        </button>
      </div>
    {%- endif -%}
  {%- endform -%}
{%- endcapture -%}

{%- liquid
  assign popup_open = false
  if open or popup_form contains 'role="status"' or popup_form contains 'role="alert"'
    assign popup_open = true
  endif
-%}

<div
  id="mp-join-popup"
  class="fixed inset-0 z-[10000] {% if popup_open %}flex{% else %}hidden{% endif %} items-center justify-center overflow-y-auto bg-black/70 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mp-join-popup-title"
  aria-hidden="{% if popup_open %}false{% else %}true{% endif %}"
  data-mp-join-popup
  {% if popup_open and open != true %}data-opened-by-form{% endif %}
>
  <div class="relative flex w-full max-w-96 flex-col overflow-hidden rounded-2xl bg-[#E9F9FA] font-nunito text-[#325037] md:h-100 md:max-w-180 md:flex-row">
    <!-- Close -->
    <button
      type="button"
      class="absolute top-4 right-4 z-10 grid h-8 w-8 cursor-pointer place-items-center rounded-full bg-[#E9F9FA] text-[#1EBECA] transition hover:opacity-70 focus-visible:opacity-70 md:top-6 md:right-6 md:h-6 md:w-6 md:bg-transparent"
      aria-label="Закрити"
      data-mp-join-popup-close
    >
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Image -->
    <div class="aspect-[336/200] w-full shrink-0 bg-white md:aspect-auto md:h-full md:w-84">
      <img
        class="h-full w-full object-cover"
        src="{{ 'know-first.webp' | asset_url }}"
        alt=""
        aria-hidden="true"
        width="672"
        height="800"
        loading="lazy"
      >
    </div>

    <!-- Content -->
    <div class="flex w-full flex-col justify-end px-4 pt-6 pb-6 md:px-6 md:pt-14">
      <h2 id="mp-join-popup-title" class="pr-8 text-[32px] leading-none font-bold md:pr-10">
        {{ popup_title | escape }}
      </h2>

      <p class="mt-2 text-[14px] leading-[1.3] font-medium">
        {{ popup_text | escape }}
      </p>

      {{ popup_form }}

      <p class="mt-6 text-[10px] leading-[1.3] font-medium">
        {{ popup_disclaimer | escape }}
      </p>
    </div>
  </div>
</div>

<script>
  (function () {
    const popup = document.getElementById('mp-join-popup');
    if (!popup || popup.dataset.ready === 'true') return;
    popup.dataset.ready = 'true';

    let lastFocused = null;

    function open() {
      lastFocused = document.activeElement;
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      popup.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');

      setTimeout(function () {
        (popup.querySelector('#mp-join-popup-email') || popup.querySelector('[data-mp-join-popup-close]'))?.focus();
      }, 50);
    }

    function close() {
      popup.classList.add('hidden');
      popup.classList.remove('flex');
      popup.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    }

    popup.addEventListener('click', function (event) {
      if (event.target === popup || event.target.closest('[data-mp-join-popup-close]')) close();
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !popup.classList.contains('hidden')) close();
    });

    // Another newsletter form on the page was submitted (its id is in the URL hash): stay closed.
    if (popup.hasAttribute('data-opened-by-form') && window.location.hash && window.location.hash !== '#mp-join-popup-form') {
      popup.classList.add('hidden');
      popup.classList.remove('flex');
      popup.setAttribute('aria-hidden', 'true');
    }

    if (!popup.classList.contains('hidden')) document.body.classList.add('overflow-hidden');

    window.mpJoinPopup = { open: open, close: close };
  })();
</script>
