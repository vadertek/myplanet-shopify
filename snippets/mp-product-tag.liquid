{%- liquid
  assign product_tag = product.metafields.custom.tag.value | default: product.metafields.custom.tag
  assign tag_label = 'My Planet'
  assign tag_bg = '#0080C7'
  assign tag_text = '#FFFFFF'

  if product_tag == 'BabyPlanet'
    assign tag_label = 'Baby Planet'
    assign tag_bg = '#D719201A'
    assign tag_text = '#A6004D'
  endif

  if tag_color != blank
    assign tag_text = tag_color
    assign tag_bg = tag_color | color_modify: 'alpha', 0.1
  endif
-%}

<span
  class="inline-flex h-8 items-center rounded-2xl px-4 font-nunito text-[14px] leading-none font-normal"
  style="background-color: {{ tag_bg }}; color: {{ tag_text }};"
>
  {{ tag_label }}
</span>
