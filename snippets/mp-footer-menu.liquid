{%- comment -%}
  Footer link list.
  Params: menu (linklist object).
{%- endcomment -%}
<ul>
  {%- for link in menu.links -%}
    <li>
      <a
        href="{{ link.url }}"
        class="inline-block transition-all duration-200 hover:text-dark-blue hover:underline focus-visible:text-dark-blue focus-visible:underline{% if link.current %} text-dark-blue{% endif %}"
        {% if link.current %}aria-current="page"{% endif %}
      >
        {{ link.title | escape }}
      </a>
    </li>
  {%- endfor -%}
</ul>
