<div id="mp-product-accordions-{{ product.id }}" class="mt-6">
  {%- liquid
    assign title_composition = 'general.custom.composition' | t
    assign title_usage = 'general.custom.usage' | t
    assign title_purpose = 'general.custom.purpose' | t
    assign title_benefits = 'general.custom.benefits' | t
    assign title_aroma = 'general.custom.aroma' | t
    assign title_allergens = 'general.custom.allergens' | t
    assign title_storage = 'general.custom.storage' | t
    assign title_packaging = 'general.custom.packaging' | t

    assign desc_aroma = product.metafields.custom.aromat.value | newline_to_br
    assign desc_allergens = product.metafields.custom.alergens.value | newline_to_br
    assign desc_storage = product.metafields.custom.safe.value | newline_to_br
    assign desc_packaging = product.metafields.custom.utilization.value | newline_to_br
  -%}
  {% render 'mp-accordion-item', title: title_composition, description: product.metafields.custom.sklad.value %}

  {% render 'mp-accordion-item', title: title_usage, description: product.metafields.custom.uses.value %}

  {% render 'mp-accordion-item', title: title_purpose, description: product.metafields.custom.appointment.value %}

  {% render 'mp-accordion-item', title: title_benefits, description: product.metafields.custom.perevaga.value %}

  {% render 'mp-accordion-item', title: title_aroma, description: desc_aroma %}

  {% render 'mp-accordion-item', title: title_allergens, description: desc_allergens %}

  {% render 'mp-accordion-item', title: title_storage, description: desc_storage %}

  {% render 'mp-accordion-item', title: title_packaging, description: desc_packaging %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const root = document.getElementById('mp-product-accordions-{{ product.id }}');
    if (!root) return;

    const items = root.querySelectorAll('.acc-item');

    function setItem(item, open) {
      const head = item.querySelector('.acc-head');
      const wrap = item.querySelector('.acc-wrap');
      const body = item.querySelector('.acc-body');
      const icon = item.querySelector('.acc-icon');

      head?.setAttribute('aria-expanded', String(open));
      wrap?.classList.toggle('grid-rows-[1fr]', open);
      wrap?.classList.toggle('grid-rows-[0fr]', !open);
      body?.classList.toggle('opacity-100', open);
      body?.classList.toggle('opacity-0', !open);
      icon?.classList.toggle('rotate-225', open);
      icon?.classList.toggle('rotate-45', !open);
    }

    items.forEach(function (item) {
      const head = item.querySelector('.acc-head');
      setItem(item, false);

      head?.addEventListener('click', function () {
        const open = head.getAttribute('aria-expanded') !== 'true';

        items.forEach(function (currentItem) {
          setItem(currentItem, currentItem === item && open);
        });
      });
    });
  });
</script>
