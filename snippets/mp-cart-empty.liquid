{%- comment -%}
  Empty cart state, shared by the cart drawer and the cart page.
  Accepts: variant ('drawer' | 'page', default 'drawer')
{%- endcomment -%}

{%- liquid
  assign is_page = false
  if variant == 'page'
    assign is_page = true
  endif
-%}

<div
  class="flex flex-1 flex-col items-center justify-center text-center font-nunito text-dark-blue {% if is_page %}rounded-2xl bg-[#F3F8FC] px-4 py-14 md:py-20{% else %}px-2 py-10{% endif %}"
  data-mp-cart-empty
>
  <div class="relative mb-6 grid h-28 w-28 place-items-center rounded-full bg-main-blue/8">
    <span class="absolute inset-3 rounded-full bg-main-blue/8" aria-hidden="true"></span>
    <svg
      class="relative h-12 w-12 text-main-blue"
      viewBox="0 0 48 48"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M10 16h28l-2.4 22.2A4 4 0 0 1 31.6 42H16.4a4 4 0 0 1-4-3.8L10 16Z"/>
      <path d="M17 16v-2a7 7 0 0 1 14 0v2"/>
      <path d="M19.5 28.5c1.2 1.4 2.7 2.1 4.5 2.1s3.3-.7 4.5-2.1"/>
    </svg>
  </div>

  <p class="{% if is_page %}text-[32px] md:text-[40px]{% else %}text-2xl{% endif %} leading-none font-bold">
    {{ 'general.custom.cart-empty-title' | t }}
  </p>

  <p class="mt-3 max-w-[340px] text-base leading-[1.3] text-main-blue/80">
    {{ 'general.custom.cart-empty-text' | t }}
  </p>

  <a
    href="{{ routes.all_products_collection_url }}"
    class="mt-8 flex w-full max-w-80 items-center justify-center rounded-2xl bg-[#3FA11F] py-4 text-xl leading-[1.35] font-normal text-white transition duration-200 hover:opacity-85 focus-visible:opacity-85"
  >
    {{ 'general.custom.cart-empty-button' | t }}
  </a>

  {%- unless is_page -%}
    <button
      type="button"
      class="mt-4 cursor-pointer text-sm leading-none text-main-blue/70 underline-offset-4 transition hover:text-main-blue hover:underline"
      data-cherie-cart-close
    >
      {{ 'general.continue_shopping' | t }}
    </button>
  {%- endunless -%}
</div>
