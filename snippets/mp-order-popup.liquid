{%- comment -%}
  Success popup (turtle background + heart).
  Not connected anywhere yet.

  Usage:
    {% render 'mp-order-popup' %}                      → hidden, "message sent" texts
    {% render 'mp-order-popup', open: true %}          → rendered open
    {% render 'mp-order-popup', variant: 'order' %}    → "order placed" texts

  Texts: Theme settings → MP Popups.
  Variants:
    message — "Ми отримали ваше повідомлення" / "Повернутися на сайт" (default)
    order   — "Дякуємо, що обрали My Planet" / "Продовжити покупки"

  Optional params override the variant texts: title, text, button_text, button_url.

  JS:
    window.mpOrderPopup.open();
    window.mpOrderPopup.close();

  Desktop: 640×400 modal over a dark overlay.
  Mobile: full-screen panel, content centered.
{%- endcomment -%}

{%- liquid
  if variant == 'order'
    assign default_title = settings.mp_popup_order_title
    assign default_text = settings.mp_popup_order_text
    assign default_button_text = settings.mp_popup_order_button
    assign default_button_url = routes.all_products_collection_url
  else
    assign default_title = settings.mp_popup_message_title
    assign default_text = settings.mp_popup_message_text
    assign default_button_text = settings.mp_popup_message_button
    assign default_button_url = routes.root_url
  endif

  assign popup_title = title | default: default_title
  assign popup_text = text | default: default_text
  assign popup_button_text = button_text | default: default_button_text
  assign popup_button_url = button_url | default: default_button_url
-%}

<div
  id="mp-order-popup"
  class="fixed inset-0 z-[10000] {% if open %}flex{% else %}hidden{% endif %} items-center justify-center bg-black/70 md:p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mp-order-popup-title"
  aria-hidden="{% if open %}false{% else %}true{% endif %}"
  data-mp-order-popup
>
  <div class="relative flex h-full w-full flex-col items-center justify-center overflow-hidden bg-white px-4 py-20 text-center font-nunito text-[#0080C7] md:h-auto md:min-h-100 md:max-w-160 md:rounded-2xl md:px-10 md:pt-18 md:pb-6">
    <!-- Background (turtle) -->
    <img
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-left-top"
      src="{{ 'Popup.webp' | asset_url }}"
      alt=""
      aria-hidden="true"
      loading="lazy"
    >

    <!-- Close -->
    <button
      type="button"
      class="absolute top-6 right-4 z-10 grid h-8 w-8 cursor-pointer place-items-center text-[#0080C7] transition hover:opacity-70 focus-visible:opacity-70 md:top-6 md:right-10"
      aria-label="Закрити"
      data-mp-order-popup-close
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 3l18 18M21 3L3 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Content -->
    <div class="relative flex w-full max-w-140 flex-col items-center">
      <h2 id="mp-order-popup-title" class="max-w-[326px] text-[32px] leading-[1.2] font-bold{% if variant == 'order' %} md:max-w-none{% endif %}">
        {{ popup_title | escape }}
      </h2>

      <img
        class="mt-14 h-auto w-[98px] md:mt-3"
        src="{{ 'Heart.webp' | asset_url }}"
        alt=""
        aria-hidden="true"
        width="98"
        height="98"
        loading="lazy"
      >

      <p class="mt-14 text-[16px] leading-[1.3] font-normal md:mt-3">
        {{ popup_text | escape }}
      </p>

      <a
        href="{{ popup_button_url }}"
        class="mt-12 flex h-[50px] w-full items-center justify-center rounded-2xl bg-[#0080C7] px-4 py-4 text-[16px] leading-none font-bold text-white transition hover:opacity-85 focus-visible:opacity-85 md:mt-3"
        data-mp-order-popup-continue
      >
        {{ popup_button_text | escape }}
      </a>
    </div>
  </div>
</div>

<script>
  (function () {
    const popup = document.getElementById('mp-order-popup');
    if (!popup || popup.dataset.ready === 'true') return;
    popup.dataset.ready = 'true';

    let lastFocused = null;

    function open() {
      lastFocused = document.activeElement;
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      popup.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');
      popup.querySelector('[data-mp-order-popup-close]')?.focus();
    }

    function close() {
      popup.classList.add('hidden');
      popup.classList.remove('flex');
      popup.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    }

    popup.addEventListener('click', function (event) {
      if (event.target === popup || event.target.closest('[data-mp-order-popup-close]')) close();
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !popup.classList.contains('hidden')) close();
    });

    if (!popup.classList.contains('hidden')) document.body.classList.add('overflow-hidden');

    window.mpOrderPopup = { open: open, close: close };
  })();
</script>
