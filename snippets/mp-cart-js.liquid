<script>
  (function () {
    const SECTION_ID = '{{ section.id }}';

    function initCart() {
      const root = document.getElementById('mp-cart-hero-' + SECTION_ID);
      const form = document.getElementById('mp-cart-form-' + SECTION_ID);
      const empty = document.getElementById('mp-cart-empty-' + SECTION_ID);
      const itemsWrap = document.getElementById('mp-cart-items-' + SECTION_ID);
      const loader = document.getElementById('mp-cart-loader-' + SECTION_ID);

      if (!root || !form || !itemsWrap || root.cartReady) return;
      root.cartReady = true;

      // key -> desired quantity, not yet sent to the server
      const pending = new Map();
      let flushTimer = null;
      let queue = Promise.resolve();
      let inFlight = 0;

      function showLoader() {
        loader?.classList.remove('hidden');
        loader?.classList.add('flex');
      }

      function hideLoader() {
        loader?.classList.add('hidden');
        loader?.classList.remove('flex');
      }

      function getRows(container) {
        return Array.from(container.querySelectorAll('[data-cart-row]'));
      }

      function getRowKeys(container) {
        return getRows(container).map(function (row) {
          return row.dataset.key;
        });
      }

      function findRow(container, key) {
        return getRows(container).find(function (row) {
          return row.dataset.key === key;
        });
      }

      function setRowQuantity(row, quantity) {
        const input = row.querySelector('.mp-cart-qty-input');
        const minus = row.querySelector('.mp-cart-qty-minus');

        if (input) input.value = quantity;
        minus?.classList.toggle('text-[#C0D7ED]', quantity <= 1);
      }

      function syncHeaderCount(cart) {
        const itemCount = Number(cart?.item_count || 0);

        document.querySelectorAll('[data-cherie-cart-count]').forEach(function (node) {
          node.textContent = itemCount;
        });

        document.querySelectorAll('[data-cherie-cart-count-badge]').forEach(function (node) {
          node.classList.toggle('hidden', itemCount === 0);
        });
      }

      function renderEmpty() {
        itemsWrap.innerHTML = '';
        form.classList.add('hidden');
        empty?.classList.remove('hidden');
      }

      function copyNode(doc, id) {
        const current = document.getElementById(id);
        const next = doc.getElementById(id);
        if (!current || !next) return;

        current.className = next.className;
        current.innerHTML = next.innerHTML;
      }

      function applyRows(newItemsWrap) {
        const sameStructure = getRowKeys(itemsWrap).join('|') === getRowKeys(newItemsWrap).join('|');

        if (sameStructure) {
          // Same lines in the same order: update in place by key (keeps focus in inputs).
          getRows(newItemsWrap).forEach(function (newRow) {
            const row = findRow(itemsWrap, newRow.dataset.key);
            if (!row) return;

            const lineTotal = row.querySelector('.mp-cart-line-total');
            const newLineTotal = newRow.querySelector('.mp-cart-line-total');
            if (lineTotal && newLineTotal) lineTotal.innerHTML = newLineTotal.innerHTML;

            if (!pending.has(row.dataset.key)) {
              const newInput = newRow.querySelector('.mp-cart-qty-input');
              if (newInput) setRowQuantity(row, parseInt(newInput.value, 10) || 1);
            }
          });
          return;
        }

        // Lines were added, removed, split or reordered: take the server markup.
        itemsWrap.innerHTML = newItemsWrap.innerHTML;

        pending.forEach(function (quantity, key) {
          const row = findRow(itemsWrap, key);
          if (row && quantity > 0) setRowQuantity(row, quantity);
        });
      }

      function render(cart, sectionHtml) {
        syncHeaderCount(cart);

        if (!cart || Number(cart.item_count || 0) === 0) {
          renderEmpty();
          return;
        }

        const doc = new DOMParser().parseFromString(sectionHtml, 'text/html');
        const newItemsWrap = doc.getElementById('mp-cart-items-' + SECTION_ID);

        if (!newItemsWrap) {
          window.location.reload();
          return;
        }

        empty?.classList.add('hidden');
        form.classList.remove('hidden');

        applyRows(newItemsWrap);
        copyNode(doc, 'mp-cart-subtotal-' + SECTION_ID);
        copyNode(doc, 'mp-cart-total-' + SECTION_ID);
        copyNode(doc, 'mp-cart-discounts-' + SECTION_ID);
      }

      function fetchState() {
        return Promise.all([
          fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (response) {
            if (!response.ok) throw new Error('Cart fetch failed');
            return response.json();
          }),
          fetch(window.location.pathname + '?sections=' + encodeURIComponent(SECTION_ID)).then(function (response) {
            if (!response.ok) throw new Error('Section fetch failed');
            return response.json();
          }),
        ]).then(function (results) {
          return { cart: results[0], html: results[1][SECTION_ID] };
        });
      }

      function sendUpdates(updates) {
        inFlight += 1;
        showLoader();

        return fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            updates: updates,
            sections: [SECTION_ID],
            sections_url: window.location.pathname,
          }),
        })
          .then(function (response) {
            if (!response.ok) throw new Error('Cart update failed');
            return response.json();
          })
          .then(function (cart) {
            const html = cart.sections && cart.sections[SECTION_ID];
            if (!html) return fetchState();
            return { cart: cart, html: html };
          })
          .catch(function (error) {
            console.error(error);
            // Re-sync with the real cart state (e.g. not enough stock, stale line key).
            return fetchState();
          })
          .then(function (state) {
            render(state.cart, state.html);
            document.dispatchEvent(new CustomEvent('cart:updated'));
          })
          .catch(function () {
            window.location.reload();
          })
          .finally(function () {
            inFlight -= 1;
            if (inFlight === 0) hideLoader();
          });
      }

      function flush() {
        clearTimeout(flushTimer);
        flushTimer = null;
        if (!pending.size) return;

        const updates = Object.fromEntries(pending);
        pending.clear();

        // Requests run one after another so responses never arrive out of order.
        queue = queue.then(function () {
          return sendUpdates(updates);
        });
      }

      function scheduleChange(key, quantity) {
        if (!key) return;

        pending.set(key, quantity);
        clearTimeout(flushTimer);
        flushTimer = setTimeout(flush, 350);
      }

      root.addEventListener('click', function (event) {
        const minus = event.target.closest('.mp-cart-qty-minus');
        const plus = event.target.closest('.mp-cart-qty-plus');
        const remove = event.target.closest('.mp-cart-remove');
        const row = event.target.closest('[data-cart-row]');

        if (!row) return;

        const key = row.dataset.key;
        const input = row.querySelector('.mp-cart-qty-input');
        const currentQuantity = parseInt(input?.value, 10) || 1;

        if (minus) {
          if (currentQuantity <= 1) return;

          setRowQuantity(row, currentQuantity - 1);
          scheduleChange(key, currentQuantity - 1);
          return;
        }

        if (plus) {
          setRowQuantity(row, currentQuantity + 1);
          scheduleChange(key, currentQuantity + 1);
          return;
        }

        if (remove) {
          pending.set(key, 0);
          flush();
        }
      });

      root.addEventListener('input', function (event) {
        const input = event.target.closest('.mp-cart-qty-input');
        const row = event.target.closest('[data-cart-row]');
        if (!input || !row || input.value === '') return;

        const quantity = Math.max(parseInt(input.value, 10) || 1, 1);

        setRowQuantity(row, quantity);
        scheduleChange(row.dataset.key, quantity);
      });

      root.addEventListener('change', function (event) {
        const input = event.target.closest('.mp-cart-qty-input');
        const row = event.target.closest('[data-cart-row]');
        if (!input || !row || input.value !== '') return;

        // Field left empty: treat as 1.
        setRowQuantity(row, 1);
        scheduleChange(row.dataset.key, 1);
      });

      form.addEventListener('submit', function (event) {
        if (!pending.size && inFlight === 0) return;

        // Send unsaved quantities before going to checkout.
        event.preventDefault();
        const submitter = event.submitter;
        flush();
        queue.then(function () {
          if (submitter && typeof form.requestSubmit === 'function') {
            form.requestSubmit(submitter);
          } else {
            form.submit();
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCart);
    } else {
      initCart();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.target && event.target.querySelector('#mp-cart-hero-' + SECTION_ID)) {
        initCart();
      }
    });
  })();
</script>
