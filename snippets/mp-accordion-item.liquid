{%- if description != blank -%}
  <div class="acc-item border-b border-(--pdp-muted)">
    <button
      class="acc-head flex w-full cursor-pointer items-center justify-between py-2 text-left font-nunito text-base leading-[1.3] font-normal text-(--pdp-accent)/80 transition hover:text-(--pdp-accent)"
      type="button"
      aria-expanded="false"
    >
      <span>{{ title }}</span>
      <span
        class="acc-icon mr-1 h-2.5 w-2.5 rotate-45 border-r-[1.5px] border-b-[1.5px] border-(--pdp-accent) transition duration-200"
        aria-hidden="true"
      ></span>
    </button>

    <div class="acc-wrap grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
      <div class="acc-body overflow-hidden opacity-0 transition-opacity duration-200">
        <div class="pb-4 font-nunito text-[14px] leading-[1.3] text-(--pdp-accent)/80">
          {{ description }}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
