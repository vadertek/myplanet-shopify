<!-- Choices -->
<section class="py-8 px-4 md:py-10">
  <div id="mp-home-choices-{{ section.id }}" class="mx-auto max-w-340">
    {%- if section.settings.title != blank -%}
      <h2 class="mb-5 font-montserrat-bold text-[16px] leading-none font-bold text-main-blue uppercase">
        {{ section.settings.title | escape }}
      </h2>
    {%- endif -%}

    <div class="grid gap-3 md:grid-cols-2 md:gap-4">
      {%- for block in section.blocks limit: 2 -%}
        {%- liquid
          assign image = block.settings.image
          assign image_mobile = block.settings.image_mobile | default: image
          assign fallback = 'bundle-' | append: forloop.index | append: '.webp'
        -%}

        <article
          class="group relative isolate flex aspect-square flex-col overflow-hidden rounded-2xl bg-[#E9E7E8] p-6 font-nunito md:aspect-[2016/1200]"
          style="--choice-text: {{ block.settings.text_color }}; --choice-btn-bg: {{ block.settings.button_bg }}; --choice-btn-text: {{ block.settings.button_text_color }};"
          {{ block.shopify_attributes }}
        >
          <!-- BACKGROUND -->
          <div class="absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100" aria-hidden="true">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 2016
                | image_tag:
                  loading: 'lazy',
                  widths: '800, 1000, 1200, 1600, 2016',
                  sizes: '(min-width: 768px) 50vw, 100vw',
                  alt: '',
                  class: 'hidden h-full w-full object-cover md:block'
              }}
              {{
                image_mobile
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '100vw',
                  alt: '',
                  class: 'h-full w-full object-cover object-right md:hidden'
              }}
            {%- elsif forloop.index <= 2 -%}
              <img
                src="{{ fallback | asset_url }}"
                alt=""
                loading="lazy"
                class="h-full w-full object-cover object-right md:object-center"
              >
            {%- endif -%}
          </div>

          <!-- CONTENT -->
          <div class="relative z-10 flex max-w-[260px] flex-col gap-3 text-(--choice-text)">
            {%- if block.settings.heading != blank -%}
              <h3 class="text-[32px] leading-none font-bold md:text-[40px]">
                {{ block.settings.heading | escape }}
              </h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="text-base leading-[1.3] font-normal opacity-80">
                {{ block.settings.text | escape }}
              </p>
            {%- endif -%}
          </div>

          {%- if block.settings.button_label != blank -%}
            <a
              href="{{ block.settings.button_link | default: '#' }}"
              class="relative z-10 mt-auto flex w-full items-center justify-center rounded-2xl bg-(--choice-btn-bg) py-4 text-base leading-none font-bold text-(--choice-btn-text) transition duration-200 hover:opacity-85 focus-visible:opacity-85 sm:w-80"
            >
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home Choices",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Choose ready solutions"
    }
  ],
  "max_blocks": 2,
  "blocks": [
    {
      "type": "choice",
      "name": "Choice block",
      "settings": [
        {
          "type": "header",
          "content": "Text Information"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Набори My Planet"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Усе необхідне для чистоти та комфорту вашого дому в одному наборі."
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Обрати набір"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Banner image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "Full banner background. Recommended 2016 × 1200 px, keep the left side free for text."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Optional. Falls back to the desktop image (cropped to the right side)."
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text",
          "default": "#004172"
        },
        {
          "type": "color",
          "id": "button_bg",
          "label": "Button background",
          "default": "#008E47"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Choices",
      "blocks": [
        {
          "type": "choice"
        },
        {
          "type": "choice",
          "settings": {
            "heading": "Набори Baby Planet",
            "text": "Ніжна турбота про малюка та спокій для батьків — у готових наборах Baby Planet.",
            "text_color": "#00A6B2",
            "button_bg": "#1EBECA"
          }
        }
      ]
    }
  ]
}
{% endschema %}
