<!-- Hero Section -->
{%- liquid
  assign image = section.settings.hero_image
  assign image_mobile = section.settings.hero_image_mobile
  assign ratio = 2.0
  if image != blank
    assign ratio = image.aspect_ratio
  endif
  assign ratio_mobile = 0.617
  if image_mobile != blank
    assign ratio_mobile = image_mobile.aspect_ratio
  endif
-%}

{%- comment -%}
  Height follows the image proportions (spacer with aspect-ratio). If the text is taller,
  the section grows and the image switches to cover (it is absolutely positioned with object-cover).
{%- endcomment -%}
<section
  class="relative grid overflow-hidden font-nunito text-white"
  style="--hero-ratio: {{ ratio }}; --hero-ratio-mobile: {{ ratio_mobile }};"
>
  <!-- HERO IMAGE -->
  <div class="absolute inset-0">
    {%- if image != blank -%}
      {{ image | image_url: width: 2880 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '1024, 1440, 1920, 2880', sizes: '100vw', alt: '', class: 'hidden h-full w-full object-cover md:block' }}
    {%- else -%}
      <img loading="eager" class="hidden h-full w-full object-cover md:block" src="{{ 'main-bg.webp' | asset_url }}" alt="">
    {%- endif -%}
    {%- if image_mobile != blank -%}
      {{ image_mobile | image_url: width: 1200 | image_tag: loading: 'eager', widths: '400, 600, 800, 1200', sizes: '100vw', alt: '', class: 'h-full w-full object-cover md:hidden' }}
    {%- else -%}
      <img loading="eager" class="h-full w-full object-cover md:hidden" src="{{ 'main-bg-mob.webp' | asset_url }}" alt="">
    {%- endif -%}
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  <!-- spacer that keeps the image proportions -->
  <div class="col-start-1 row-start-1 aspect-(--hero-ratio-mobile) w-full md:aspect-(--hero-ratio)" aria-hidden="true"></div>

  <!-- CONTENT -->
  <div class="relative col-start-1 row-start-1 mx-auto flex w-full max-w-[1440px] items-end px-4 py-10 md:items-center md:px-10">
    <div class="flex max-w-[640px] flex-col items-start">
      {%- if section.settings.hero_tag != blank -%}
        <span class="rounded-full border border-white px-4 py-2 text-sm leading-none">{{ section.settings.hero_tag | escape }}</span>
      {%- endif -%}
      <h1 class="mt-4 text-[48px] leading-[0.9] font-bold md:text-[64px]">{{ section.settings.hero_title | escape }}</h1>
      {%- if section.settings.hero_description != blank -%}
        <p class="mt-4 max-w-[560px] text-base leading-[1.3]">{{ section.settings.hero_description | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% render 'mp-breadcrumb' %}

{% schema %}
{
  "name": "MP Hero",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "hero_tag",
      "label": "Hero Tag",
      "default": "MyPlanet"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Турбота починається на кухні"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Безпечні та ефективні засоби для чистоти поверхонь, посуду, фруктів і овочів — для комфортного та здорового простору щодня."
    }
  ]
}
{% endschema %}
