{%- comment -%}
  "Our philosophy": full-width photo, title + rich text top-left, logo bottom-left.
  Mobile: text first, then the photo with the logo on it.
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
-%}

{%- capture logo -%}
  {%- if section.settings.logo != blank -%}
    {{ section.settings.logo | image_url: width: 480 | image_tag: loading: 'lazy', alt: 'My Planet', class: 'h-full w-auto' }}
  {%- else -%}
    {%- comment -%} Built-in dark logo turned light: invert + hue-rotate keeps the blue "My" badge blue {%- endcomment -%}
    <img src="{{ 'header-logo.webp' | asset_url }}" alt="My Planet" loading="lazy" class="h-full w-auto [filter:invert(1)_hue-rotate(180deg)]">
  {%- endif -%}
{%- endcapture -%}

<section
  id="mp-product-philosophy-{{ section.id }}"
  class="relative overflow-hidden bg-white font-nunito text-[#325037]"
>
  <!-- DESKTOP PHOTO -->
  <div class="absolute inset-0 hidden lg:block" aria-hidden="true">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 2752
        | image_tag:
          loading: 'lazy',
          widths: '1024, 1440, 2048, 2752',
          sizes: '100vw',
          alt: '',
          class: 'h-full w-full object-cover object-right'
      }}
    {%- else -%}
      <img src="{{ 'philosophy.webp' | asset_url }}" alt="" loading="lazy" class="h-full w-full object-cover object-right">
    {%- endif -%}
  </div>

  <div class="relative mx-auto max-w-[1440px] px-4 pt-10 lg:aspect-[2048/1152] lg:max-h-[810px] lg:min-h-[560px] lg:px-10">
    <!-- CONTENT -->
    <div class="max-w-[523px]">
      {%- if section.settings.title != blank -%}
        <h2 class="text-[48px] leading-[0.9] font-bold xl:text-[64px]">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="mt-8 text-base leading-[1.3] [&_p+p]:mt-5 [&_strong]:font-bold">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    <!-- LOGO (desktop) -->
    <div class="absolute bottom-10 left-10 hidden h-12 lg:block">{{ logo }}</div>
  </div>

  <!-- MOBILE PHOTO -->
  <div class="relative mt-8 aspect-[4/3] lg:hidden">
    {%- if image_mobile != blank -%}
      {{
        image_mobile
        | image_url: width: 1200
        | image_tag:
          loading: 'lazy',
          widths: '400, 600, 800, 1200',
          sizes: '100vw',
          alt: section.settings.title,
          class: 'absolute inset-0 h-full w-full object-cover object-[70%_center]'
      }}
    {%- else -%}
      <img
        src="{{ 'philosophy.webp' | asset_url }}"
        alt="{{ section.settings.title | escape }}"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover object-[70%_center]"
      >
    {%- endif -%}
    <div class="absolute bottom-4 left-4 h-8">{{ logo }}</div>
  </div>
</section>

{% schema %}
{
  "name": "MP Product philosophy",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Наша філософія"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>У світі, що постійно змінюється, незмінними залишаються речі, які справді важливі: дім, родина та комфорт.</p><p>Саме тому My Planet уже понад 78 років розробляє продукти, що поєднують ефективність, безпечні формули та відповідальне ставлення до ресурсів.</p><p><strong>Ми віримо, що довіра формується роками, а якість підтверджується щодня.</strong></p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "2048 × 1152 px. Keep the top-left area light for the text. If empty, the built-in photo is used."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional, 4:3. Falls back to the desktop image."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "White logo (PNG/SVG with transparency). If empty, the header logo is shown in light colors."
    }
  ],
  "presets": [
    {
      "name": "MP Product philosophy"
    }
  ]
}
{% endschema %}
