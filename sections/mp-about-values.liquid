{%- comment -%}
  "Our values" for the About us page: left-aligned title, 3 cards (icon + title + text).
  Desktop: 3 columns. Mobile: stacked.
{%- endcomment -%}

{%- assign fallback_icons = 'icon-people.webp,icon-house.webp,icon-planet.webp' | split: ',' -%}

<section class="px-4 py-10 font-nunito text-main-blue md:px-10 md:py-16">
  <div class="mx-auto max-w-340">
    {%- if section.settings.title != blank -%}
      <h2 class="text-[40px] leading-none font-normal">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="mt-6 grid gap-2 md:mt-8 md:grid-cols-3">
      {%- for block in section.blocks -%}
        <div class="flex items-center gap-4 rounded-2xl bg-main-blue/5 p-4 md:min-h-[152px]" {{ block.shopify_attributes }}>
          <div class="grid h-24 w-24 shrink-0 place-items-center md:h-30 md:w-30">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 196 | image_tag: class: 'h-20 w-20 object-contain md:h-[98px] md:w-[98px]', loading: 'lazy', alt: '' }}
            {%- elsif fallback_icons[forloop.index0] -%}
              <img class="h-20 w-20 object-contain md:h-[98px] md:w-[98px]" src="{{ fallback_icons[forloop.index0] | asset_url }}" alt="" loading="lazy">
            {%- endif -%}
          </div>

          <div class="min-w-0">
            {%- if block.settings.title != blank -%}
              <h3 class="text-xl leading-none font-bold">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="mt-3 text-sm leading-[1.3] opacity-90">{{ block.settings.text | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MP About values",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Наші цінності"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Value",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Square, 196 × 196 px. If empty, the built-in icon is used (family, house, planet)."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Для родини"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Безпечні рішення для щоденного використання."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MP About values",
      "blocks": [
        { "type": "item", "settings": { "title": "Для родини", "text": "Безпечні рішення для щоденного використання." } },
        { "type": "item", "settings": { "title": "Для дому", "text": "Ефективні формули для чистоти вашого дому." } },
        { "type": "item", "settings": { "title": "Турбота про планету", "text": "Відповідальні інгредієнти та екологічний підхід." } }
      ]
    }
  ]
}
{% endschema %}
