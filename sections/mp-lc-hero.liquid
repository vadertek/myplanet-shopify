{% render 'mp-breadcrumb' %}

<section class="px-4 py-8 md:py-10">
  <div class="mx-auto max-w-340">
    <div class="grid gap-3 md:grid-cols-2 md:gap-4">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_link = block.settings.button_link
          if card_link != blank
            assign card_tag = 'a'
          else
            assign card_tag = 'article'
          endif
        -%}
        <{{ card_tag }}
          {% if card_link != blank %}
            href="{{ card_link }}"
          {% endif %}
          class="group relative isolate flex aspect-square flex-col overflow-hidden rounded-2xl px-5 py-5 md:px-10 md:py-10{% if card_link != blank %} transition-shadow duration-300 hover:shadow-[0_10px_30px_rgba(0,65,114,0.15)] focus-visible:shadow-[0_10px_30px_rgba(0,65,114,0.15)]{% endif %}"
          style="background-color: {{ block.settings.background_color }};"
          {{ block.shopify_attributes }}
        >
          <div class="z-10 flex max-w-70 flex-col items-start md:max-w-107.5">
            <h3
              class="font-montserrat-bold text-[32px] leading-none font-bold md:whitespace-nowrap md:text-[40px]"
              style="color: {{ block.settings.title_color }};"
            >
              {{ block.settings.title }}
            </h3>
            <p
              class="mt-3 font-montserrat-reg text-[12px] leading-tight md:max-w-[60%] md:text-[16px]"
              style="color: {{ block.settings.text_color }};"
            >
              {{ block.settings.text }}
            </p>
          </div>

          {%- liquid
            assign img_class = 'absolute inset-0 -z-10 h-full w-full object-cover'
            if card_link != blank
              assign img_class = img_class | append: ' transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none'
            endif
          -%}
          {%- if block.settings.image != blank -%}
            <img class="{{ img_class }}" src="{{ block.settings.image | image_url: width: 1400 }}" alt="" loading="eager">
          {%- else -%}
            <img class="{{ img_class }}" src="{{ 'col.webp' | asset_url }}" alt="">
          {%- endif -%}
        </{{ card_tag }}>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MP LC Hero",
  "settings": [],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "bundle_card",
      "name": "Bundle card",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "My Planet Bundles"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Все необхідне для чистоти та комфорту вашого дому в одному наборі."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Card link",
          "info": "The whole card becomes a link"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#CCE6F4"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color",
          "default": "#003B5C"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#003B5C"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MP LC Hero",
      "blocks": [
        {
          "type": "bundle_card",
          "settings": {
            "title": "My Planet Bundles",
            "text": "Все необхідне для чистоти та комфорту вашого дому в одному наборі.",
            "background_color": "#CCE6F4",
            "title_color": "#003B5C",
            "text_color": "#003B5C"
          }
        },
        {
          "type": "bundle_card",
          "settings": {
            "title": "Baby Planet Bundles",
            "text": "Ніжна турбота для малюка та спокій для батьків - у готових комплектах Baby Planet.",
            "background_color": "#D2F2F4",
            "title_color": "#00A8B5",
            "text_color": "#008895"
          }
        }
      ]
    }
  ]
}
{% endschema %}
