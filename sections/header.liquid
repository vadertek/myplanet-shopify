<!-- Topbar -->
<div class="hidden h-8 w-full items-center justify-center {% if template.suffix == 'baby' or template.suffix == 'babyplanet' %} bg-[#1EBECA] {% else %} bg-main-blue {% endif %} md:flex">
  <p class="font-montserrat-reg text-sm text-white">{{ section.settings.top_bar }}</p>
</div>

<!-- Header -->
<header id="header-{{ section.id }}" class="mx-auto max-w-360 relative border-t-2 border-main-blue bg-white md:border-t-0">
  <div class="flex items-center justify-between px-4 py-3 md:px-7 md:py-4">
    <!-- Logo -->
    <a href="/">
      <img loading="eager" class="h-8 md:h-10" src="{{ 'header-logo.webp' | asset_url }}" alt="My Planet">
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:block">
      <ul class="flex space-x-6">
        {%- for link in linklists['main-menu'].links -%}
          <li>
            <a
              href="{{ link.url }}"
              class="text-dark-blue transition duration-200 hover:text-main-blue{% if link.current %} text-main-blue{% endif %}"
            >
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-5 md:space-x-4">
      {% render 'mp-header-search' %}

      <a class="group relative inline-flex h-7 w-7 items-center justify-center" href="{{ routes.cart_url }}" data-cherie-cart-open aria-haspopup="dialog">
        <img loading="eager" class="h-5 transition-transform duration-200 group-hover:scale-150 md:h-4" src="{{ 'cart-icon.svg' | asset_url }}" alt="Кошик">
        <span
          class="absolute -top-1 -right-1 grid h-4 min-w-4 place-items-center rounded-full border border-white bg-main-blue px-1 font-montserrat-bold text-[10px] leading-none font-bold text-white shadow-[0_4px_10px_rgba(0,128,199,0.25)]{% if cart.item_count == 0 %} hidden{% endif %}"
          data-cherie-cart-count-badge
          aria-hidden="true"
        >
          <span data-cherie-cart-count>{{ cart.item_count }}</span>
        </span>
      </a>
      <button
        id="header-burger-{{ section.id }}"
        type="button"
        class="flex h-8 w-8 cursor-pointer flex-col items-center justify-center rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-main-blue/40 md:hidden"
        aria-label="Відкрити меню"
        aria-expanded="false"
      >
        <span class="flex w-5 flex-col items-end gap-1.5">
          <span id="header-burger-top-{{ section.id }}" class="h-0.5 w-5 rounded-full bg-[#0080C7] transition-all duration-200"></span>
          <span id="header-burger-middle-{{ section.id }}" class="h-0.5 w-5 rounded-full bg-[#0080C7] transition-all duration-200"></span>
          <span id="header-burger-bottom-{{ section.id }}" class="h-0.5 w-2.5 rounded-full bg-[#0080C7] transition-all duration-200"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <nav
    id="header-mobile-menu-{{ section.id }}"
    class="pointer-events-none absolute right-0 left-0 z-20 max-h-0 -translate-y-2 overflow-hidden rounded-b-3xl border-t border-[#C0D7ED]/40 bg-white px-4 opacity-0 shadow-[0_16px_32px_rgba(0,65,114,0.12)] transition-all duration-300 md:hidden"
    aria-label="Мобільне меню"
  >
    <ul class="flex flex-col pt-2">
      {%- for link in linklists['main-menu'].links -%}
        <li class="border-b border-[#C0D7ED]/40 last:border-b-0">
          <a
            href="{{ link.url }}"
            class="group flex items-center justify-between py-4 font-montserrat-med text-[17px] leading-none transition duration-200 hover:text-main-blue focus-visible:text-main-blue{% if link.current %} text-main-blue{% else %} text-dark-blue{% endif %}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span>{{ link.title }}</span>
            <span class="grid h-8 w-8 place-items-center rounded-full bg-[#C0D7ED]/25 text-main-blue transition duration-200 group-hover:translate-x-0.5 group-hover:bg-[#C0D7ED]/50">
              {% render 'mp-slider-arrow', direction: 'next' %}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.top_bar != blank -%}
      <p class="mt-2 mb-5 rounded-2xl {% if template.suffix == 'baby' or template.suffix == 'babyplanet' %}bg-[#1EBECA]/10 text-[#1EBECA]{% else %}bg-main-blue/8 text-main-blue{% endif %} px-4 py-3 text-center font-montserrat-med text-[13px] leading-tight">
        {{ section.settings.top_bar }}
      </p>
    {%- else -%}
      <div class="h-3"></div>
    {%- endif -%}
  </nav>
</header>

<script>
  (function () {
    function initHeader() {
      const burger = document.getElementById('header-burger-{{ section.id }}');
      const menu = document.getElementById('header-mobile-menu-{{ section.id }}');
      const topLine = document.getElementById('header-burger-top-{{ section.id }}');
      const middleLine = document.getElementById('header-burger-middle-{{ section.id }}');
      const bottomLine = document.getElementById('header-burger-bottom-{{ section.id }}');

      if (!burger || !menu || burger.headerReady) return;
      burger.headerReady = true;

      function setMenu(open) {
        const isOpen = !open;

        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? 'Закрити меню' : 'Відкрити меню');

        menu.classList.toggle('max-h-0', isOpen);
        menu.classList.toggle('max-h-[80vh]', !isOpen);
        menu.classList.toggle('-translate-y-2', isOpen);
        menu.classList.toggle('translate-y-0', !isOpen);
        menu.classList.toggle('opacity-0', isOpen);
        menu.classList.toggle('opacity-100', !isOpen);
        menu.classList.toggle('pointer-events-none', isOpen);
        menu.classList.toggle('pointer-events-auto', !isOpen);

        topLine?.classList.toggle('translate-y-2', !isOpen);
        topLine?.classList.toggle('rotate-45', !isOpen);
        middleLine?.classList.toggle('opacity-0', !isOpen);
        bottomLine?.classList.toggle('-translate-y-2', !isOpen);
        bottomLine?.classList.toggle('w-2.5', isOpen);
        bottomLine?.classList.toggle('w-5', !isOpen);
        bottomLine?.classList.toggle('-rotate-45', !isOpen);
      }

      burger.addEventListener('click', function () {
        setMenu(burger.getAttribute('aria-expanded') !== 'true');
      });

      // Close on outside click and Escape
      document.addEventListener('click', function (event) {
        if (burger.getAttribute('aria-expanded') !== 'true') return;
        if (menu.contains(event.target) || burger.contains(event.target)) return;
        setMenu(false);
      });

      document.addEventListener('keyup', function (event) {
        if (event.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') setMenu(false);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeader);
    } else {
      initHeader();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.target && event.target.querySelector('#header-{{ section.id }}')) {
        initHeader();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "MP - Header",
  "settings": [
    {
      "type": "text",
      "id": "top_bar",
      "label": "Top Bar Text",
      "default": "Безкоштовна доставка від 1000 грн"
    }
  ]
}
{% endschema %}
