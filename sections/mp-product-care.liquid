{%- comment -%}
  "Care for every corner": text + 2 small photos on the left, 1 big photo on the right.
  Mobile: all photos in a slider. Colors and fallback photos depend on the product template
  (product.babyplanet → Baby Planet palette and bp-*.webp, otherwise My Planet and mp-*.webp).
{%- endcomment -%}

{%- liquid
  assign text_color = '#236591'
  assign img_prefix = 'mp-'
  if template.suffix == 'babyplanet'
    assign text_color = '#325037'
    assign img_prefix = 'bp-'
  endif

  assign cards = section.blocks
-%}

<section
  id="mp-product-care-{{ section.id }}"
  class="overflow-hidden px-4 py-10 font-nunito md:px-10 md:py-16"
  style="color: {{ text_color }}; --care-color: {{ text_color }};"
>
  <div class="mx-auto max-w-340">
    <!-- DESKTOP -->
    <div class="hidden gap-2 md:grid md:grid-cols-2">
      <div class="flex flex-col">
        <div class="mb-8 flex flex-1 flex-col">
          {%- if section.settings.title != blank -%}
            <h2 class="text-[40px] leading-none font-bold">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="mt-4 text-base leading-[1.3] opacity-80">{{ section.settings.text | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>

        <div class="grid grid-cols-2 gap-2">
          {%- for block in cards limit: 2 -%}
            {%- liquid
              assign fallback = img_prefix | append: forloop.index | append: '.webp'
            -%}
            <div {{ block.shopify_attributes }}>
              {% render 'mp-product-care-card', block: block, fallback: fallback, ratio: 'aspect-square', widths: '334, 500, 668', sizes: '(min-width: 1440px) 334px, 25vw' %}
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- for block in cards offset: 2 limit: 1 -%}
        {%- liquid
          assign fallback = img_prefix | append: '3-big.webp'
        -%}
        <div class="flex flex-col" {{ block.shopify_attributes }}>
          {% render 'mp-product-care-card', block: block, fallback: fallback, ratio: 'min-h-0 flex-1', widths: '676, 1000, 1352', sizes: '(min-width: 1440px) 676px, 50vw' %}
        </div>
      {%- endfor -%}
    </div>

    <!-- MOBILE -->
    <div class="md:hidden">
      {%- if section.settings.title != blank -%}
        <h2 class="text-[40px] leading-none font-bold">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="mt-4 text-base leading-[1.3] opacity-80">{{ section.settings.text | escape | newline_to_br }}</p>
      {%- endif -%}

      <div id="care-swiper-{{ section.id }}" class="swiper mt-6 overflow-visible">
        <div class="swiper-wrapper flex">
          {%- for block in cards limit: 3 -%}
            {%- liquid
              if forloop.index == 3
                assign fallback = img_prefix | append: '3-big.webp'
              else
                assign fallback = img_prefix | append: forloop.index | append: '.webp'
              endif
            -%}
            <div class="swiper-slide w-full shrink-0">
              {% render 'mp-product-care-card', block: block, fallback: fallback, ratio: 'aspect-square', widths: '400, 600, 800', sizes: '90vw' %}
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if cards.size > 1 -%}
        <div class="mx-auto mt-6 flex h-9 w-22 overflow-hidden rounded-full bg-(--care-color)/8" aria-label="Gallery navigation">
          <button
            id="care-prev-{{ section.id }}"
            class="grid h-9 w-11 cursor-pointer place-items-center text-(--care-color)/80 transition hover:bg-white/45 focus-visible:bg-white/45 [&.swiper-button-disabled]:cursor-default [&.swiper-button-disabled]:opacity-40"
            type="button"
            aria-label="Previous"
          >
            <span class="h-3.5 w-3.5 rotate-45 border-b-2 border-l-2 border-current" aria-hidden="true"></span>
          </button>
          <button
            id="care-next-{{ section.id }}"
            class="grid h-9 w-11 cursor-pointer place-items-center text-(--care-color)/80 transition hover:bg-white/45 focus-visible:bg-white/45 [&.swiper-button-disabled]:cursor-default [&.swiper-button-disabled]:opacity-40"
            type="button"
            aria-label="Next"
          >
            <span class="h-3.5 w-3.5 rotate-225 border-b-2 border-l-2 border-current" aria-hidden="true"></span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var sectionId = '{{ section.id }}';

    function initCareSwiper() {
      var swiperEl = document.getElementById('care-swiper-' + sectionId);
      if (!swiperEl || typeof Swiper === 'undefined') return;
      if (swiperEl.swiper) swiperEl.swiper.destroy(true, true);

      new Swiper(swiperEl, {
        slidesPerView: 1.12,
        spaceBetween: 8,
        speed: 350,
        watchOverflow: true,
        navigation: {
          nextEl: '#care-next-' + sectionId,
          prevEl: '#care-prev-' + sectionId,
        },
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCareSwiper);
    } else {
      initCareSwiper();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === sectionId) initCareSwiper();
    });
  })();
</script>

{% schema %}
{
  "name": "MP Product care",
  "max_blocks": 3,
  "settings": [
    {
      "type": "paragraph",
      "content": "Text color and default photos follow the product template: Baby Planet for product.babyplanet, My Planet for others."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Свій догляд для кожного куточка"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Кожен куточок дому потребує свого догляду. Саме тому My Planet створює засоби для прання, миття посуду, очищення поверхонь, скла та підлоги, допомагаючи підтримувати чистоту без зайвих зусиль."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1st and 2nd: square 668 × 668 px. 3rd (big): 1352 × 966 px. If empty, the built-in photo is used."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Caption",
          "default": "Для прання"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MP Product care",
      "blocks": [
        { "type": "card", "settings": { "label": "Для прання" } },
        { "type": "card", "settings": { "label": "Для миття посуду" } },
        { "type": "card", "settings": { "label": "Для чистоти всього дому" } }
      ]
    }
  ]
}
{% endschema %}
