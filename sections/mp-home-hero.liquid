<!-- Hero Slider Section -->
<section
  id="mp-home-hero-{{ section.id }}"
  class="relative overflow-hidden"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div id="hero-swiper-{{ section.id }}" class="swiper w-full overflow-hidden">
    <div class="swiper-wrapper flex">
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_first = forloop.first
          if is_first
            assign loading = 'eager'
            assign fetch_priority = 'high'
          else
            assign loading = 'lazy'
            assign fetch_priority = 'auto'
          endif

          assign image = block.settings.image
          assign image_mobile = block.settings.image_mobile | default: image
          assign alt = block.settings.title | escape

          comment
            Fallback for the first two slides until images are picked in the admin.
          endcomment
          assign fallback_desktop = ''
          assign fallback_mobile = ''
          if forloop.index <= 2
            assign fallback_desktop = 'hero-slide-' | append: forloop.index | append: '.webp'
            assign fallback_mobile = 'hero-slide-mob-' | append: forloop.index | append: '.webp'
          endif
        -%}

        <div
          class="swiper-slide relative w-full shrink-0 [&:not(.swiper-slide-active)]:pointer-events-none"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ forloop.length }}"
          style="--hero-bg: {{ block.settings.bg_color }}; --hero-text: {{ block.settings.text_color }}; --hero-btn-bg: {{ block.settings.button_bg }}; --hero-btn-text: {{ block.settings.button_text_color }};"
          {{ block.shopify_attributes }}
        >
          <div class="relative h-[538px] bg-(--hero-bg) lg:h-auto lg:min-h-[480px] lg:aspect-[1881/836]">
            <!-- MEDIA -->
            <div class="absolute inset-0">
              {%- comment -%} Desktop media {%- endcomment -%}
              <div class="absolute inset-0 hidden lg:block">
                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1920x', class: 'h-full w-full object-cover' }}
                {%- elsif image != blank -%}
                  {{
                    image
                    | image_url: width: 2400
                    | image_tag:
                      loading: loading,
                      fetchpriority: fetch_priority,
                      widths: '1024, 1280, 1440, 1680, 1920, 2400',
                      sizes: '100vw',
                      alt: block.settings.title,
                      class: 'h-full w-full object-cover'
                  }}
                {%- elsif fallback_desktop != blank -%}
                  <img
                    src="{{ fallback_desktop | asset_url }}"
                    alt="{{ alt }}"
                    loading="{{ loading }}"
                    fetchpriority="{{ fetch_priority }}"
                    class="h-full w-full object-cover"
                  >
                {%- endif -%}
              </div>

              {%- comment -%} Mobile media {%- endcomment -%}
              <div class="absolute inset-x-0 top-0 lg:hidden [mask-image:linear-gradient(to_bottom,#000_calc(100%-28px),transparent)] [-webkit-mask-image:linear-gradient(to_bottom,#000_calc(100%-28px),transparent)]">
                {%- assign video_mobile = block.settings.video_mobile | default: block.settings.video -%}
                {%- if video_mobile != blank -%}
                  {{ video_mobile | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1080x', class: 'block aspect-[1185/987] w-full object-cover' }}
                {%- elsif image_mobile != blank -%}
                  {{
                    image_mobile
                    | image_url: width: 1200
                    | image_tag:
                      loading: loading,
                      fetchpriority: fetch_priority,
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '100vw',
                      alt: block.settings.title,
                      class: 'block aspect-[1185/987] w-full object-cover'
                  }}
                {%- elsif fallback_mobile != blank -%}
                  <img
                    src="{{ fallback_mobile | asset_url }}"
                    alt="{{ alt }}"
                    loading="{{ loading }}"
                    fetchpriority="{{ fetch_priority }}"
                    class="block aspect-[1185/987] w-full object-cover"
                  >
                {%- endif -%}
              </div>
            </div>

            <!-- CONTENT -->
            <div class="absolute inset-0">
              <div class="mx-auto flex h-full max-w-[1440px] items-end px-4 pb-8 lg:px-10 lg:pb-20 2xl:pb-32">
                <div class="flex w-full flex-col gap-6 font-nunito text-(--hero-text) lg:max-w-[440px] xl:max-w-[520px]">
                  {%- if block.settings.title != blank -%}
                    {%- if is_first -%}
                      <h1 class="text-[40px] leading-[0.9] font-extrabold uppercase lg:text-[48px] xl:text-[64px]">
                        {{ block.settings.title | escape }}
                      </h1>
                    {%- else -%}
                      <h2 class="text-[40px] leading-[0.9] font-extrabold uppercase lg:text-[48px] xl:text-[64px]">
                        {{ block.settings.title | escape }}
                      </h2>
                    {%- endif -%}
                  {%- endif -%}

                  {%- if block.settings.description != blank -%}
                    <p class="text-base leading-[1.3] font-normal">
                      {{ block.settings.description | escape | newline_to_br }}
                    </p>
                  {%- endif -%}

                  {%- if block.settings.button_text != blank -%}
                    <a
                      href="{{ block.settings.button_link | default: '#' }}"
                      class="flex w-full items-center justify-center gap-2 rounded-2xl bg-(--hero-btn-bg) py-4 text-base leading-none font-bold text-(--hero-btn-text) transition duration-200 hover:opacity-85 focus-visible:opacity-85 sm:w-80"
                      {% unless is_first %}
                        tabindex="-1"
                      {% endunless %}
                    >
                      {{ block.settings.button_text | escape }}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_pagination and section.blocks.size > 1 -%}
      <div
        id="hero-pagination-{{ section.id }}"
        class="absolute bottom-4 left-0 z-10 flex w-full justify-center gap-2 lg:bottom-6 [&_.swiper-pagination-bullet]:block [&_.swiper-pagination-bullet]:h-2 [&_.swiper-pagination-bullet]:w-2 [&_.swiper-pagination-bullet]:cursor-pointer [&_.swiper-pagination-bullet]:rounded-full [&_.swiper-pagination-bullet]:bg-black/25 [&_.swiper-pagination-bullet]:transition-all [&_.swiper-pagination-bullet-active]:w-6 [&_.swiper-pagination-bullet-active]:bg-black"
      ></div>
    {%- endif -%}
  </div>
</section>

<!-- Hero Swiper Script -->
<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var autoplayDelay = {{ section.settings.autoplay_speed | times: 1000 }};

    function syncFocusable(swiper) {
      swiper.slides.forEach(function (slide, index) {
        var isActive = index === swiper.activeIndex;
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        slide.querySelectorAll('a, button').forEach(function (el) {
          if (isActive) el.removeAttribute('tabindex');
          else el.setAttribute('tabindex', '-1');
        });
      });
    }

    function initHeroSwiper() {
      var swiperEl = document.getElementById('hero-swiper-' + sectionId);
      if (!swiperEl || typeof Swiper === 'undefined') return;

      if (swiperEl.swiper) swiperEl.swiper.destroy(true, true);

      var slidesCount = swiperEl.querySelectorAll('.swiper-slide').length;
      var paginationEl = document.getElementById('hero-pagination-' + sectionId);

      var swiper = new Swiper(swiperEl, {
        effect: 'fade',
        fadeEffect: { crossFade: true },
        speed: 600,
        rewind: slidesCount > 1,
        allowTouchMove: slidesCount > 1,
        watchOverflow: true,
        autoplay:
          slidesCount > 1 && !(window.Shopify && Shopify.designMode)
            ? {
                delay: autoplayDelay,
                disableOnInteraction: false,
              }
            : false,
        pagination: paginationEl
          ? {
              el: paginationEl,
              clickable: true,
            }
          : false,
        on: {
          init: syncFocusable,
          slideChange: syncFocusable,
        },
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSwiper);
    } else {
      initHeroSwiper();
    }

    // Theme editor support
    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === sectionId) initHeroSwiper();
    });

    document.addEventListener('shopify:block:select', function (event) {
      if (!event.detail || event.detail.sectionId !== sectionId) return;
      var swiperEl = document.getElementById('hero-swiper-' + sectionId);
      if (!swiperEl || !swiperEl.swiper) return;
      var slides = Array.prototype.slice.call(swiperEl.querySelectorAll('.swiper-slide'));
      var index = slides.indexOf(event.target);
      if (index > -1) swiperEl.swiper.slideTo(index);
    });
  })();
</script>

{% schema %}
{
  "name": "MP Hero",

  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "Autoplay is paused inside the theme editor."
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": false
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Promo"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "Recommended 1880 × 836 px. Keep the left side free for text."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Shown full width at the top, text sits at the bottom. Recommended 1185 × 987 px. Falls back to the desktop image."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Desktop video",
          "info": "Optional. Replaces the desktop image; plays muted and looped."
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "Mobile video",
          "info": "Optional. Falls back to the desktop video."
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Black Friday"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Безпечні та ефективні засоби для чистоти поверхонь, посуду, фруктів і овочів — для комфортного та здорового простору щодня."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Дізнатися більше"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background",
          "default": "#FFFFFF",
          "info": "Visible on mobile below the image."
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "button_bg",
          "label": "Button background",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MP Hero slider",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
