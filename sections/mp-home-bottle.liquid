<!-- Bottle Section -->
<section class="relative overflow-hidden">
  <!-- HERO IMAGE -->
  {% if section.settings.hero_image != blank %}
    <img loading="eager" class="hidden max-h-200 w-full object-cover md:block" src="{{ section.settings.hero_image |  image_url  }}" alt="">
  {% else %}
    <img loading="eager" class="hidden max-h-200 w-full object-cover md:block" src="{{ 'bottle.webp' |  asset_url }}" alt="">
  {% endif %}
  {% if section.settings.hero_image_mobile != blank %}
    <img loading="eager" class="w-full object-cover md:hidden" src="{{ section.settings.hero_image_mobile | image_url  }}" alt="">
  {% else %}
    <img loading="eager" class="w-full object-cover md:hidden" src="{{ 'bottle-mob.webp' |  asset_url }}" alt="">
  {% endif %}

  <div class="absolute inset-0 mx-auto max-w-[1440px]">
    <div
      class="absolute top-6 right-4 left-4 flex max-w-[633px] flex-col font-nunito text-[#004172] md:top-1/2 md:right-auto md:left-10 md:-translate-y-1/2"
      style="--bottle-btn-bg: {{ section.settings.button_bg }}; --bottle-btn-text: {{ section.settings.button_text_color }};"
    >
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1" aria-hidden="true">
          {%- for i in (1..5) -%}
            <img class="h-4 w-[17px]" src="{{ 'blue-star.svg' | asset_url }}" alt="" width="17" height="16">
          {%- endfor -%}
        </div>
        <span class="text-sm leading-none">{{ section.settings.hero_tag | escape }}</span>
      </div>
      <h2 class="mt-3 max-w-[363px] text-[48px] leading-[46px] font-extrabold uppercase md:max-w-none">
        {{ section.settings.hero_title | escape }}
      </h2>
      <p class="mt-4 max-w-[363px] text-2xl leading-none font-semibold md:max-w-none">
        {{ section.settings.hero_description | escape }}
      </p>
      <a
        href="{{ section.settings.hero_button_link | default: '#' }}"
        class="mt-6 flex w-[234px] items-center justify-center rounded-2xl bg-(--bottle-btn-bg) py-4 text-xl leading-[1.35] font-normal text-(--bottle-btn-text) transition duration-200 hover:opacity-85 focus-visible:opacity-85 md:w-80 md:px-0"
      >
        {{ section.settings.hero_button_text | escape }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MP Bottle Section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "hero_tag",
      "label": "Reviews",
      "default": "4.9/5 · 12 000+ покупців"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "ПРОДУКТ 2026 РОКУ!"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "ColdFusion+ ефективно видаляє складні плями за низьких температур."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Hero Button Link"
    },
    {
      "type": "text",
      "id": "hero_button_text",
      "label": "Hero Button Text",
      "default": "Замовити зараз"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#3FA11F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
