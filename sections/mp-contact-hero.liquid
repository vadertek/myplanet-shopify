{%- comment -%}
  Contact hero: image + title, text and Shopify contact form.
  Desktop: full-width background image, content on the left.
  Mobile: image on top, content below on a solid background.
{%- endcomment -%}

{%- assign image_mobile = section.settings.image_mobile | default: section.settings.image -%}

<section
  id="mp-contact-hero-{{ section.id }}"
  class="relative overflow-hidden font-nunito text-[#004172]"
  style="background-color: {{ section.settings.background }};"
>
  <!-- BACKGROUND -->
  <div class="md:absolute md:inset-0" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2880
        | image_tag:
          loading: 'eager',
          widths: '1200, 1600, 2000, 2880',
          sizes: '100vw',
          alt: '',
          class: 'hidden h-full w-full object-cover object-right md:block'
      }}
    {%- else -%}
      <img loading="eager" class="hidden h-full w-full object-cover object-right md:block" src="{{ 'contact-hero.webp' | asset_url }}" alt="">
    {%- endif -%}

    {%- if image_mobile != blank -%}
      {{
        image_mobile
        | image_url: width: 1200
        | image_tag:
          loading: 'eager',
          widths: '400, 600, 800, 1200',
          sizes: '100vw',
          alt: '',
          class: 'w-full object-cover md:hidden'
      }}
    {%- else -%}
      <img loading="eager" class="w-full object-cover md:hidden" src="{{ 'contact-hero-mob.webp' | asset_url }}" alt="">
    {%- endif -%}
  </div>

  <!-- CONTENT -->
  <div class="relative mx-auto max-w-360 px-4 pt-4 pb-8 md:px-10 md:py-20">
    <div class="w-full md:max-w-160">
      {%- if section.settings.title != blank -%}
        <h1 class="text-[48px] leading-[0.9] font-bold md:text-[64px]">
          {{ section.settings.title | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="mt-3 text-[14px] leading-[1.3] md:mt-4 md:text-[16px]">
          {{ section.settings.text | escape }}
        </p>
      {%- endif -%}

      {%- form 'contact', id: 'mp-contact-form', class: 'mt-6 flex flex-col md:mt-8' -%}
        {%- if form.posted_successfully? -%}
          <p class="mb-4 rounded-lg bg-white px-4 py-3 text-[16px] leading-[1.3] text-[#3FA11F]" role="status" tabindex="-1" autofocus>
            {{ section.settings.success_text | escape }}
          </p>
        {%- elsif form.errors -%}
          <div class="mb-4 rounded-lg bg-white px-4 py-3 text-[16px] leading-[1.3] text-[#D71920]" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="flex flex-col gap-2">
          <label class="sr-only" for="ContactForm-name-{{ section.id }}">{{ 'templates.contact.form.name' | t }}</label>
          <input
            id="ContactForm-name-{{ section.id }}"
            class="w-full rounded-lg bg-white px-4 py-2 text-[16px] leading-[1.3] text-[#004172] outline-none placeholder:text-[#0080C7] focus-visible:ring-2 focus-visible:ring-[#0080C7]/40"
            type="text"
            name="contact[name]"
            autocomplete="name"
            placeholder="{{ 'templates.contact.form.name' | t | escape }}"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          >

          <label
            class="flex w-full cursor-text items-center justify-between gap-4 rounded-lg bg-white px-4 py-2 text-[16px] leading-[1.3] focus-within:ring-2 focus-within:ring-[#0080C7]/40"
            for="ContactForm-phone-{{ section.id }}"
          >
            <span class="shrink-0 text-[#0080C7]">{{ 'general.custom.phone' | t }}*</span>
            <input
              id="ContactForm-phone-{{ section.id }}"
              class="min-w-0 flex-1 bg-transparent text-right text-[#004172] outline-none placeholder:text-[#004172]"
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
              inputmode="tel"
              placeholder="+38 (0__) ___-__-__"
              required
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            >
          </label>

          <label class="sr-only" for="ContactForm-email-{{ section.id }}">{{ 'general.custom.email' | t }}</label>
          <input
            id="ContactForm-email-{{ section.id }}"
            class="w-full rounded-lg bg-white px-4 py-2 text-[16px] leading-[1.3] text-[#004172] outline-none placeholder:text-[#0080C7] focus-visible:ring-2 focus-visible:ring-[#0080C7]/40"
            type="email"
            name="contact[email]"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            placeholder="{{ 'general.custom.email' | t | escape }}"
            required
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          >

          <label class="sr-only" for="ContactForm-body-{{ section.id }}">{{ 'general.custom.message' | t }}</label>
          <textarea
            id="ContactForm-body-{{ section.id }}"
            class="h-38 w-full resize-none rounded-lg bg-white px-4 py-2 text-[16px] leading-[1.3] text-[#004172] outline-none placeholder:text-[#0080C7] focus-visible:ring-2 focus-visible:ring-[#0080C7]/40"
            name="contact[body]"
            placeholder="{{ 'general.custom.message' | t | escape }}"
          >{{- form.body -}}</textarea>
        </div>

        <button
          type="submit"
          class="mt-6 flex h-13 w-full cursor-pointer items-center justify-center rounded-2xl border-2 border-[#004172] bg-[#004172] text-[16px] leading-none font-medium text-white transition duration-200 hover:bg-white hover:text-[#004172] focus-visible:bg-white focus-visible:text-[#004172] md:mt-8 md:w-80"
        >
          {{ section.settings.button_text | escape }}
        </button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MP Contact hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)",
      "info": "If empty, the built-in image is used."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background (mobile, under the form)",
      "default": "#EAE5DE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Ми завжди поруч"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Потрібна консультація, інформація про продукцію чи допомога з вибором? Напишіть нам — ми відповімо найближчим часом."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Надіслати повідомлення"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Дякуємо! Ми отримали ваше повідомлення і зв’яжемося з вами найближчим часом."
    }
  ],
  "presets": [
    {
      "name": "MP Contact hero"
    }
  ]
}
{% endschema %}
