{%- comment -%}
  Policy / text page (privacy, terms, etc.): title + one rich text.
  Content comes from the "Content" setting; if it is empty, the page content
  (Online Store → Pages) is used. Headings, paragraphs, lists, links and
  bold text are styled automatically.
{%- endcomment -%}

{%- liquid
  assign policy_title = section.settings.title | default: page.title
  assign policy_content = section.settings.content
  if policy_content == blank
    assign policy_content = page.content
  endif
-%}

<style>
  #mp-policy-{{ section.id }} .mp-policy-content > :first-child { margin-top: 0; }
  #mp-policy-{{ section.id }} .mp-policy-content > :last-child { margin-bottom: 0; }

  #mp-policy-{{ section.id }} .mp-policy-content h1,
  #mp-policy-{{ section.id }} .mp-policy-content h2,
  #mp-policy-{{ section.id }} .mp-policy-content h3,
  #mp-policy-{{ section.id }} .mp-policy-content h4,
  #mp-policy-{{ section.id }} .mp-policy-content h5,
  #mp-policy-{{ section.id }} .mp-policy-content h6 {
    margin: 0 0 12px;
    padding-top: 16px;
    border-top: 1px solid rgb(192 215 237 / 0.3);
    color: #0080c7;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3;
  }
  #mp-policy-{{ section.id }} .mp-policy-content > h1:first-child,
  #mp-policy-{{ section.id }} .mp-policy-content > h2:first-child,
  #mp-policy-{{ section.id }} .mp-policy-content > h3:first-child,
  #mp-policy-{{ section.id }} .mp-policy-content > h4:first-child {
    border-top: 0;
    padding-top: 0;
  }

  #mp-policy-{{ section.id }} .mp-policy-content p,
  #mp-policy-{{ section.id }} .mp-policy-content ul,
  #mp-policy-{{ section.id }} .mp-policy-content ol,
  #mp-policy-{{ section.id }} .mp-policy-content table {
    margin: 0 0 16px;
  }
  #mp-policy-{{ section.id }} .mp-policy-content ul,
  #mp-policy-{{ section.id }} .mp-policy-content ol {
    padding-left: 32px;
  }
  #mp-policy-{{ section.id }} .mp-policy-content ul { list-style: disc; }
  #mp-policy-{{ section.id }} .mp-policy-content ol { list-style: decimal; }
  #mp-policy-{{ section.id }} .mp-policy-content li + li { margin-top: 2px; }
  #mp-policy-{{ section.id }} .mp-policy-content li > p { margin: 0; }

  #mp-policy-{{ section.id }} .mp-policy-content strong,
  #mp-policy-{{ section.id }} .mp-policy-content b { font-weight: 700; }
  #mp-policy-{{ section.id }} .mp-policy-content em,
  #mp-policy-{{ section.id }} .mp-policy-content i { font-style: italic; }

  #mp-policy-{{ section.id }} .mp-policy-content a {
    color: #0080c7;
    text-decoration: underline;
    text-underline-offset: 2px;
    word-break: break-word;
  }
  #mp-policy-{{ section.id }} .mp-policy-content a:hover { text-decoration: none; }

  #mp-policy-{{ section.id }} .mp-policy-content table {
    width: 100%;
    border-collapse: collapse;
  }
  #mp-policy-{{ section.id }} .mp-policy-content th,
  #mp-policy-{{ section.id }} .mp-policy-content td {
    padding: 8px;
    border: 1px solid rgb(192 215 237 / 0.5);
    text-align: left;
  }

  #mp-policy-{{ section.id }} .mp-policy-content img {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
  }
</style>

<section id="mp-policy-{{ section.id }}" class="px-4 py-10 font-nunito md:px-10 md:py-14">
  <div class="mx-auto max-w-340">
    {%- if policy_title != blank -%}
      <h1 class="mb-8 text-center text-[32px] leading-none font-bold text-[#004172] md:mb-12 md:text-[40px]">
        {{ policy_title | escape }}
      </h1>
    {%- endif -%}

    {%- if policy_content != blank -%}
      <div class="mp-policy-content mx-auto max-w-155 text-[14px] leading-[1.3] text-[#004172] md:text-[16px]">
        {{ policy_content }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "MP Policy",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "If empty, the page title is used."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "info": "If empty, the page content (Online Store → Pages) is used. The page editor also supports headings."
    }
  ],
  "presets": [
    {
      "name": "MP Policy"
    }
  ]
}
{% endschema %}
