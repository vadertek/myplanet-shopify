{%- comment -%}
  All lines list: one card per block (image + brand badge + title + text + button).
  Brand switch (My Planet / Baby Planet) sets the badge and button color.
  Desktop: image left, content right. Mobile: image on top.
{%- endcomment -%}

<section id="mp-all-lines-grid-{{ section.id }}" class="bg-[#F2F2F7] px-4 py-8 font-nunito md:px-10 md:py-10">
  <div class="mx-auto flex max-w-340 flex-col gap-3 md:gap-4">
    {%- for block in section.blocks -%}
      {%- liquid
        if block.settings.brand == 'bp'
          assign brand_color = '#1EBECA'
          assign brand_label = 'BabyPlanet'
        else
          assign brand_color = '#0080C7'
          assign brand_label = 'MyPlanet'
        endif
      -%}

      <article
        class="grid overflow-hidden rounded-2xl bg-white md:grid-cols-2 md:min-h-100"
        style="--line-color: {{ brand_color }};"
        {{ block.shopify_attributes }}
      >
        <div class="aspect-[673/400] w-full overflow-hidden bg-[#C0D7ED]/20 md:aspect-auto md:h-full">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400, 700, 1000, 1400',
                sizes: '(min-width: 768px) 50vw, 100vw',
                alt: block.settings.title,
                class: 'h-full w-full object-cover'
            }}
          {%- endif -%}
        </div>

        <div class="flex flex-col items-start justify-center px-4 py-6 text-[#004172] md:px-9 md:py-10">
          <span class="rounded-full border border-(--line-color) px-3 py-1 text-[14px] leading-[1.3] font-normal text-(--line-color) md:text-[16px]">
            {{ brand_label }}
          </span>

          {%- if block.settings.title != blank -%}
            <h2 class="mt-3 text-[24px] leading-none font-bold md:mt-4 md:text-[32px]">
              {{ block.settings.title | escape }}
            </h2>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="mt-3 text-[14px] leading-[1.3] font-normal md:mt-4 md:max-w-[608px] md:text-[16px]">
              {{ block.settings.text | escape }}
            </p>
          {%- endif -%}

          {%- if block.settings.button_text != blank -%}
            <a
              href="{{ block.settings.button_link | default: '#' }}"
              class="mt-6 flex h-12 w-full items-center justify-center rounded-2xl border-2 border-white bg-(--line-color) text-[16px] leading-none font-medium text-white transition duration-200 hover:opacity-85 focus-visible:opacity-85 md:mt-10 md:w-80"
            >
              {{ block.settings.button_text | escape }}
            </a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "MP All lines grid",
  "settings": [],
  "blocks": [
    {
      "type": "line",
      "name": "Line",
      "settings": [
        {
          "type": "select",
          "id": "brand",
          "label": "Brand",
          "info": "Sets the badge and button color.",
          "options": [
            { "value": "mp", "label": "My Planet" },
            { "value": "bp", "label": "Baby Planet" }
          ],
          "default": "mp"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Used on desktop and mobile. About 1346 × 800 px."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Чиста кухня без зайвих зусиль"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Усе необхідне для миття посуду вручну й у посудомийній машині та безпечного миття овочів і фруктів"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Переглянути товари"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MP All lines grid",
      "blocks": [
        { "type": "line", "settings": { "brand": "mp" } },
        { "type": "line", "settings": { "brand": "bp", "title": "Догляд за дитячою білизною", "text": "Лінійка для прання дитячих речей поєднує ефективне очищення, гіпоалергенні формули та м’який догляд, щоб одяг залишався чистим, свіжим і комфортним для чутливої шкіри малюків." } }
      ]
    }
  ]
}
{% endschema %}
