{%- comment -%}
  Instagram block: title + "Subscribe" button, 6 square photos.
  Desktop: 6 in a row. Mobile: 3 × 2 grid, button below.
  Setting ids small_image_1..4 / main_image are kept from the old version so existing templates keep their photos.
{%- endcomment -%}

{%- liquid
  assign link = section.settings.button_link | default: settings.social_instagram_link
  assign image_ids = 'small_image_1,small_image_2,small_image_3,small_image_4,main_image,image_6' | split: ','
-%}

{%- capture button -%}
  {%- if section.settings.button_text != blank -%}
    <a
      href="{{ link | default: '#' }}"
      {% if link != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
      class="flex w-full items-center justify-center rounded-2xl bg-main-blue px-16 py-4 text-xl leading-[1.35] font-normal text-white transition duration-200 hover:opacity-85 focus-visible:opacity-85 md:w-auto md:text-base md:leading-[1.3]"
    >
      {{ section.settings.button_text | escape }}
    </a>
  {%- endif -%}
{%- endcapture -%}

<section class="bg-[#EEF4FA] px-4 py-8 font-nunito text-[#236591] md:px-10 md:py-10">
  <div class="mx-auto max-w-340">
    <div class="flex items-center justify-between gap-6">
      {%- if section.settings.title != blank -%}
        <h2 class="text-[28px] leading-[1.2] font-normal md:text-2xl [&_strong]:font-bold">{{ section.settings.title }}</h2>
      {%- endif -%}
      <div class="hidden shrink-0 md:block">{{ button }}</div>
    </div>

    <div class="mt-8 grid grid-cols-3 gap-1 md:mt-6 md:grid-cols-6">
      {%- for id in image_ids -%}
        {%- assign image = section.settings[id] -%}
        {%- capture fallback -%}in-{{ forloop.index }}.webp{%- endcapture -%}
        <a
          href="{{ link | default: '#' }}"
          {% if link != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
          class="group relative block aspect-square overflow-hidden rounded-2xl"
          tabindex="-1"
          aria-hidden="true"
        >
          {%- if image != blank -%}
            {{
              image
              | image_url: width: 476
              | image_tag:
                loading: 'lazy',
                widths: '160, 240, 320, 476',
                sizes: '(min-width: 768px) 16vw, 33vw',
                alt: '',
                class: 'h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.05] motion-reduce:transition-none'
            }}
          {%- else -%}
            <img
              src="{{ fallback | asset_url }}"
              alt=""
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.05] motion-reduce:transition-none"
            >
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>

    <div class="mt-10 md:hidden">{{ button }}</div>
  </div>
</section>

{% schema %}
{
  "name": "MP home community",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Життя між прибираннями — в <strong>Instagram</strong>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Підписатися"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "If empty, the Instagram link from Theme settings → Social media is used. Photos lead to the same link."
    },
    {
      "type": "header",
      "content": "Photos",
      "info": "Square, 476 × 476 px. Empty slots use the built-in photos."
    },
    {
      "type": "image_picker",
      "id": "small_image_1",
      "label": "Photo 1"
    },
    {
      "type": "image_picker",
      "id": "small_image_2",
      "label": "Photo 2"
    },
    {
      "type": "image_picker",
      "id": "small_image_3",
      "label": "Photo 3"
    },
    {
      "type": "image_picker",
      "id": "small_image_4",
      "label": "Photo 4"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Photo 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Photo 6"
    }
  ],
  "presets": [
    {
      "name": "MP home community"
    }
  ]
}
{% endschema %}
