<!-- Hero Section -->
<section class="relative overflow-hidden">
  <!-- HERO IMAGE -->
  {% if section.settings.hero_image != blank %}
    <img loading="eager" class="md:block hidden max-h-120 2xl:max-h-140 w-full object-cover" src="{{ section.settings.hero_image |  image_url  }}" alt="">
  {% else %}
    <img loading="eager" class="md:block hidden max-h-120 2xl:max-h-140 w-full object-cover" src="{{ 'main-bg.webp' |  asset_url }}" alt="">
  {% endif %}
  {% if section.settings.hero_image_mobile != blank %}
    <img loading="eager" class="md:hidden w-full object-cover" src="{{ section.settings.hero_image_mobile | image_url  }}" alt="">
  {% else %}
    <img loading="eager" class="md:hidden w-full object-cover" src="{{ 'main-bg-mob.webp' |  asset_url }}" alt="">
  {% endif %}

  <div class="absolute inset-0 bg-black/35"></div>
  <div class="absolute inset-0 mx-auto max-w-[1440px]">
    <div class="absolute bottom-10 left-4 flex max-w-120 flex-col gap-6 text-white md:bottom-20 md:left-10">
      <span class="w-fit rounded-full border border-white px-6 py-2 text-sm leading-none">{{ section.settings.hero_tag }}</span>
      <h1 class="max-w-170 font-montserrat-bold text-[48px] leading-[0.95] font-bold md:text-[64px]">{{ section.settings.hero_title }}</h1>
      <p class="max-w-180 font-montserrat-reg leading-[1.45] text-sm">{{ section.settings.hero_description }}</p>
      {%- if section.settings.button_text != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="flex h-10 w-60 items-center justify-center rounded-2xl bg-white/80 px-6 py-3 font-nunito text-sm leading-none font-semibold text-dark-blue backdrop-blur-sm transition duration-200 hover:bg-white focus-visible:bg-white"
        >
          {{ section.settings.button_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% render 'mp-breadcrumb' %}

{% schema %}
{
  "name": "MP Hero",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "hero_tag",
      "label": "Hero Tag",
      "default": "MyPlanet"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Турбота починається на кухні"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Безпечні та ефективні засоби для чистоти поверхонь, посуду, фруктів і овочів — для комфортного та здорового простору щодня."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Про My Planet",
      "info": "Leave empty to hide the button."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
