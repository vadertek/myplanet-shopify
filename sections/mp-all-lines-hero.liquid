{%- comment -%}
  All lines hero: full-width image with title and text.
  Desktop: text on the left, vertically centered. Mobile: text on top.
{%- endcomment -%}

{%- assign image_mobile = section.settings.image_mobile | default: section.settings.image -%}

<section
  id="mp-all-lines-hero-{{ section.id }}"
  class="relative overflow-hidden font-nunito"
  style="--hero-text: {{ section.settings.text_color }};"
>
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2880
      | image_tag:
        loading: 'eager',
        widths: '1200, 1600, 2000, 2880',
        sizes: '100vw',
        alt: '',
        class: 'hidden w-full object-cover md:block md:min-h-[440px]'
    }}
  {%- else -%}
    <img loading="eager" class="hidden w-full object-cover md:block md:min-h-[440px]" src="{{ 'all-lines-hero.webp' | asset_url }}" alt="">
  {%- endif -%}

  {%- if image_mobile != blank -%}
    {{
      image_mobile
      | image_url: width: 1200
      | image_tag:
        loading: 'eager',
        widths: '400, 600, 800, 1200',
        sizes: '100vw',
        alt: '',
        class: 'w-full object-cover md:hidden'
    }}
  {%- else -%}
    <img loading="eager" class="w-full object-cover md:hidden" src="{{ 'all-lines-hero-mob.webp' | asset_url }}" alt="">
  {%- endif -%}

  <div class="absolute inset-0 mx-auto max-w-360">
    <div class="absolute inset-x-4 top-8 flex flex-col text-(--hero-text) md:inset-x-auto md:top-1/2 md:left-10 md:-translate-y-1/2">
      {%- if section.settings.title != blank -%}
        <h1 class="max-w-[571px] text-[40px] leading-[0.9] font-bold md:text-[64px]">
          {{ section.settings.title | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="mt-3 max-w-[341px] text-[18px] leading-[1.1] font-normal md:text-[24px]">
          {{ section.settings.text | escape }}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MP All lines hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)",
      "info": "If empty, the built-in image is used."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Усі засоби My Planet і Baby Planet"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Усе необхідне для чистоти вашого дому."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "MP All lines hero"
    }
  ]
}
{% endschema %}
